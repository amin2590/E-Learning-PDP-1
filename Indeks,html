    ];
    let current=0,answers=Array(35).fill(null),submitted=false,secondsLeft=3600,paused=false,timerHandle=null,timedOut=false;
    const $=id=>document.getElementById(id),questionText=$("question-text"),answerForm=$("answer-form"),questionButtons=$("question-buttons");

    function formatTime(){return String(Math.floor(secondsLeft/60)).padStart(2,"0")+":"+String(secondsLeft%60).padStart(2,"0")}
    function updateTimer(){
      $("timer-time").textContent=formatTime();
      $("timer-card").classList.toggle("warning",secondsLeft<600&&secondsLeft>=60);
      $("timer-card").classList.toggle("danger",secondsLeft<60);
      $("timer-state").textContent=paused&&secondsLeft>0?"DIJEDA":"";
    }
    function renderButtons(){
      questionButtons.innerHTML="";
      questions.forEach((q,i)=>{const b=document.createElement("button");b.type="button";b.className="nav-question";b.textContent=i+1;b.setAttribute("aria-label","Soal "+(i+1));b.onclick=()=>{if(!submitted){current=i;renderQuiz()}};questionButtons.appendChild(b)});
    }
    function renderQuiz(){
      const q=questions[current];questionText.textContent=(current+1)+". "+q[0];answerForm.innerHTML="";
      q.slice(1,5).forEach((text,i)=>{
        const id="q"+current+"o"+i,label=document.createElement("label"),radio=document.createElement("input"),span=document.createElement("span");
        label.className="option";label.htmlFor=id;radio.type="radio";radio.id=id;radio.name="question";radio.checked=answers[current]===i;radio.disabled=submitted;
        radio.onchange=()=>{answers[current]=i;renderQuiz()};span.textContent=text;label.append(radio,span);
        if(submitted&&i===q[5])label.classList.add("correct");
        if(submitted&&answers[current]===i&&i!==q[5])label.classList.add("incorrect");
        answerForm.appendChild(label);
      });
      [...questionButtons.children].forEach((b,i)=>{b.classList.toggle("active",i===current);b.classList.toggle("answered",answers[i]!==null);b.setAttribute("aria-current",i===current?"step":"false")});
      $("previous-button").disabled=current===0;$("next-button").disabled=current===34;$("submit-row").classList.toggle("hidden",submitted);
    }
    function scoreData(){
      const correct=answers.reduce((n,a,i)=>n+(a===questions[i][5]?1:0),0),answered=answers.filter(x=>x!==null).length,score=Math.min(100,correct*point);
      return {correct,answered,score};
    }
    function buildSummary(){
      const body=$("summary-body");body.innerHTML="";
      questions.forEach((q,i)=>{const selected=answers[i]===null?"Tidak dijawab":q[answers[i]+1],correct=q[q[5]+1],ok=answers[i]===q[5];const row=document.createElement("tr");row.innerHTML="<td>"+(i+1)+"</td><td>"+q[0]+"</td><td>"+selected+"</td><td>"+correct+"</td><td class='"+(ok?"status-ok":"status-no")+"'>"+(ok?"Benar":"Salah")+"</td><td>"+(ok?point.toFixed(2):"0.00")+"</td>";body.appendChild(row)});
    }
    function showResults(timeout=false){
      submitted=true;paused=true;timedOut=timeout;clearInterval(timerHandle);$("confirmation-modal").classList.add("hidden");
      const d=scoreData(),pass=d.score>=70;$("result-summary").textContent="Jumlah benar: "+d.correct+" dari 35 soal. Terjawab: "+d.answered+" dari 35 soal. Nilai akhir: "+d.score.toFixed(2)+" / 100. Status: "+(pass?"Lulus":"Perlu mengulang")+".";
      $("time-notice").textContent=timeout?"Waktu telah habis. Kuis dikunci dan hasil ditampilkan.":"";$("time-notice").classList.toggle("hidden",!timeout);
      buildSummary();$("result-panel").classList.remove("hidden");renderQuiz();$("result-panel").scrollIntoView({behavior:"smooth",block:"nearest"});
    }
    function startTimer(){timerHandle=setInterval(()=>{if(!paused&&secondsLeft>0){secondsLeft--;updateTimer();if(secondsLeft===0)showResults(true)}},1000)}
    $("sidebar-toggle").onclick=()=>{const s=$("sidebar");if(innerWidth<=700){s.classList.toggle("mobile-open");$("sidebar-toggle").setAttribute("aria-expanded",s.classList.contains("mobile-open"))}else{s.classList.toggle("collapsed");$("sidebar-toggle").setAttribute("aria-expanded",!s.classList.contains("collapsed"))}};
    $("courses-menu-button").onclick=()=>{const open=$("course-submenu").classList.toggle("hidden");$("courses-menu-button").setAttribute("aria-expanded",String(!open))};
    $("submenu-kepi").onclick=()=>{$("submenu-kepi").classList.add("active");$("submenu-umum").classList.remove("active")};
    $("submenu-umum").onclick=()=>{$("submenu-umum").classList.add("active");$("submenu-kepi").classList.remove("active")};
    $("previous-button").onclick=()=>{if(current>0){current--;renderQuiz()}};
    $("next-button").onclick=()=>{if(current<34){current++;renderQuiz()}};
    $("submit-button").onclick=()=>{$("modal-message").textContent="Anda telah mengisi "+answers.filter(x=>x!==null).length+" dari 35 soal. Apakah Anda yakin ingin menyelesaikan kuis?";$("confirmation-modal").classList.remove("hidden");$("confirm-submit").focus()};
    $("cancel-submit").onclick=()=>$("confirmation-modal").classList.add("hidden");
    $("confirm-submit").onclick=()=>showResults(false);
    $("confirmation-modal").onclick=e=>{if(e.target===$("confirmation-modal"))$("confirmation-modal").classList.add("hidden")};
    $("timer-toggle").onclick=()=>{if(secondsLeft===0||submitted)return;paused=!paused;$("timer-toggle").textContent=paused?"▶":"Ⅱ";$("timer-toggle").setAttribute("aria-label",paused?"Lanjutkan timer":"Jeda timer");updateTimer()};
    $("restart-button").onclick=()=>{answers=Array(35).fill(null);current=0;submitted=false;secondsLeft=3600;paused=false;timedOut=false;clearInterval(timerHandle);$("participant-name").value="";$("send-status").textContent="";$("send-status").className="send-status";$("send-button").disabled=false;$("send-button").textContent="Kirim hasil ke Spreadsheet";$("result-panel").classList.add("hidden");$("timer-toggle").textContent="Ⅱ";$("timer-toggle").setAttribute("aria-label","Jeda timer");updateTimer();renderQuiz();startTimer();scrollTo({top:0,behavior:"smooth"})};
    $("send-button").onclick=async e=>{
      const button=e.currentTarget,d=scoreData(),name=$("participant-name").value.trim(),payload={
        namaPengguna:name||null,timestamp:new Date().toISOString(),totalSoal:35,jumlahBenar:d.correct,jumlahTerjawab:d.answered,nilai:Number(d.score.toFixed(2)),durasiTimerAwal:"60:00",sisaWaktu:formatTime(),statusLulus:d.score>=70,answers:questions.map((q,i)=>({nomor:i+1,question:q[0],selectedAnswer:answers[i]===null?null:q[answers[i]+1],correctAnswer:q[q[5]+1],isCorrect:answers[i]===q[5],score:answers[i]===q[5]?point:0}))
      };
      button.disabled=true;button.textContent="Mengirim...";$("send-status").textContent="Mengirim hasil ke Spreadsheet...";$("send-status").className="send-status";
      try{const response=await fetch(endpoint,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(payload)});if(!response.ok)throw new Error("Respons server tidak berhasil");$("send-status").textContent="Hasil berhasil dikirim ke Spreadsheet";$("send-status").className="send-status success";button.textContent="Hasil telah dikirim"}
      catch(err){$("send-status").textContent="Hasil belum dapat dikirim ke Spreadsheet. Periksa koneksi atau pengaturan CORS endpoint, lalu coba lagi."; $("send-status").className="send-status error";button.disabled=false;button.textContent="Coba kirim lagi"}
    };
    renderButtons();renderQuiz();updateTimer();startTimer();
  </script>
 
